{
  "name": "jean-pierregassin/collabbing",
  "description": "Collaborate better.",
  "keywords": [
    "collaborate",
    "ideas"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.5",
    "graham-campbell/github": "^13.1",
    "graham-campbell/markdown": "^16.1",
    "guzzlehttp/guzzle": "^7.9",
    "inertiajs/inertia-laravel": "^3.1",
    "laravel/framework": "^13.0",
    "laravel/socialite": "^5.2",
    "laravel/tinker": "^3.0",
    "laravel/ui": "^4.6"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9",
    "laravel/boost": "*",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
      ]
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ],
    "analyse": "phpstan analyse --memory-limit=1G --debug",
    "analyze": "@analyse",
    "lint": "pint --test",
    "lint:fix": "pint",
    "quality": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "test": "phpunit --colors=always",
    "test-integration": "phpunit --testsuite=integration --colors=always",
    "test-all": "phpunit --testsuite=stable,integration --colors=always"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": true
    },
    "platform": {
      "php": "8.5.5"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
