APP_NAME=collabbing
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=collabbing
DB_USERNAME=collabbing
DB_PASSWORD=secret

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Docker starter kit
APP_HOST_PATH=.
APP_CONTAINER_PATH=/var/www/html
APP_HTTP_PORT=8080

NGINX_WEB_ROOT=/var/www/html/public
NGINX_INDEX=index.php index.html
NGINX_FASTCGI_PASS=php:9000

NODE_PORT=5173

MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025

MYSQL_PORT=33066
MYSQL_DATABASE=collabbing
MYSQL_USER=collabbing
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

REDIS_PORT=6379

NGINX_IMAGE_TAG=1.30.1-alpine
PHP_VERSION=8.5
PHP_VARIANT=fpm-bookworm
COMPOSER_VERSION=2
NODE_VERSION=24
NODE_VARIANT=bookworm
MYSQL_IMAGE_TAG=9.7
REDIS_IMAGE_TAG=8.6-alpine
MAILHOG_IMAGE_TAG=v1.0.1

TZ=Australia/Brisbane

XDEBUG_MODE=develop,debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
