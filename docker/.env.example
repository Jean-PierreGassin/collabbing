# Application
APP_NAME=collabbing
APP_HOST_PATH=..
APP_CONTAINER_PATH=/var/www/html

# HTTP
APP_HTTP_PORT=8080
NODE_PORT=5173

# Nginx
NGINX_WEB_ROOT=/var/www/html/public
NGINX_INDEX=index.php index.html
NGINX_FASTCGI_PASS=php:9000

# MailHog
MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025

# MySQL
MYSQL_PORT=33066
MYSQL_DATABASE=collabbing
MYSQL_USER=collabbing
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_PORT=6379

# Images
NGINX_IMAGE_TAG=1.30.1-alpine
PHP_VERSION=8.5
PHP_VARIANT=fpm-bookworm
COMPOSER_VERSION=2
NODE_VERSION=24
NODE_VARIANT=bookworm
MYSQL_IMAGE_TAG=9.7
REDIS_IMAGE_TAG=8.6-alpine
MAILHOG_IMAGE_TAG=v1.0.1

# Runtime
TZ=Australia/Brisbane

# Xdebug
XDEBUG_MODE=develop,debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
